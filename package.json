{
  "name": "profit-script",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "电商多平台粗算毛利分析面板",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "verify:real": "tsx scripts/verify-real.ts",
    "package:app": "node scripts/build-app.mjs",
    "package:app:win": "node scripts/build-app.mjs --targets win-x64",
    "package:app:mac": "node scripts/build-app.mjs --targets macos-arm64,macos-x64"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "echarts": "^5.6.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "pinia": "^3.0.1",
    "saxes": "^6.0.0",
    "unzipper": "^0.12.3",
    "vue": "^3.5.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/unzipper": "^0.10.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "archiver": "^8.0.0",
    "concurrently": "^9.1.2",
    "playwright-core": "^1.50.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
